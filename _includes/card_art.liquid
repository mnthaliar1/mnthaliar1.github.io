{% comment %}
  Simple illustrations for the homepage section cards.
  Usage: {% include card_art.liquid art="research" %}
  Options: research, writing, publications, frame, fieldnotes
{% endcomment %}
{% case include.art %}
  {% when 'research' %}
    <svg width="140" height="120" viewBox="0 0 140 120" fill="none" aria-hidden="true">
      <g fill="#111111">
        <circle cx="20" cy="20" r="3"></circle><circle cx="45" cy="20" r="3"></circle><circle cx="70" cy="20" r="3"></circle>
        <circle cx="20" cy="45" r="3"></circle><circle cx="45" cy="45" r="3"></circle><circle cx="20" cy="70" r="3"></circle>
        <circle cx="20" cy="95" r="3"></circle><circle cx="45" cy="95" r="3"></circle>
      </g>
      <circle cx="88" cy="66" r="30" fill="#F47C3C" stroke="#111111" stroke-width="3"></circle>
      <path d="M110 88 128 106" stroke="#111111" stroke-width="5" stroke-linecap="round"></path>
    </svg>
  {% when 'writing' %}
    <svg width="140" height="120" viewBox="0 0 140 120" fill="none" aria-hidden="true">
      <rect x="28" y="14" width="78" height="96" rx="8" fill="#FFFFFF" stroke="#111111" stroke-width="3"></rect>
      <path d="M42 38h50M42 54h50M42 70h34" stroke="#111111" stroke-width="3" stroke-linecap="round"></path>
      <circle cx="104" cy="88" r="20" fill="#F47C3C"></circle>
    </svg>
  {% when 'publications' %}
    <svg width="140" height="120" viewBox="0 0 140 120" fill="none" aria-hidden="true">
      <rect x="44" y="12" width="66" height="86" rx="6" fill="#FFFFFF" stroke="#111111" stroke-width="3"></rect>
      <rect x="30" y="24" width="66" height="86" rx="6" fill="#FFFFFF" stroke="#111111" stroke-width="3"></rect>
      <path d="M42 46h42M42 60h42M42 74h26" stroke="#111111" stroke-width="3" stroke-linecap="round"></path>
      <circle cx="102" cy="96" r="16" fill="#F47C3C"></circle>
    </svg>
  {% when 'frame' %}
    <svg width="140" height="120" viewBox="0 0 140 120" fill="none" aria-hidden="true">
      <rect x="22" y="18" width="96" height="84" rx="4" stroke="#111111" stroke-width="3"></rect>
      <rect x="34" y="30" width="72" height="60" fill="#FFFFFF"></rect>
      <circle cx="118" cy="70" r="22" fill="#F47C3C"></circle>
      <path d="M34 90 58 62l18 18 12-12 18 22" stroke="#111111" stroke-width="3" stroke-linejoin="round"></path>
    </svg>
  {% when 'fieldnotes' %}
    <svg width="140" height="120" viewBox="0 0 140 120" fill="none" aria-hidden="true">
      <path d="M30 80a40 40 0 0 1 80 0Z" fill="#F47C3C"></path>
      <path d="M16 80h108M30 96h80M48 110h44" stroke="#111111" stroke-width="3" stroke-linecap="round"></path>
      <path d="M70 20v12M38 34l8 8M102 34l-8 8" stroke="#111111" stroke-width="3" stroke-linecap="round"></path>
    </svg>
{% endcase %}
